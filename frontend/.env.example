VITE_CONTRACT_ADDRESS=0xCc539393dD59dEd32d65B537A77515f59B760aa3

# Arc Testnet RPC endpoint used by wagmi (config/wagmi.js) and by
# api/_lib/chain.js's server-side reads. Defaults to Circle's shared public
# gateway (rpc.testnet.arc.network) if left unset, but that gateway has been
# observed returning HTTP 400 on CORS preflight (OPTIONS) requests, which
# fails every browser-side RPC call regardless of retries. Point this at a
# dedicated provider endpoint (e.g. an Alchemy Arc Testnet app) instead. Not
# a secret in the usual sense — it's read client-side by design, like any
# wallet-app RPC URL — but still don't commit a real key-bearing value here;
# set the real one in the Vercel project's environment variables.
VITE_ARC_RPC_URL_ALCHEMY=

# Pinata gateway used to turn a pinned invoice's ipfs:// URI into a clickable/
# fetchable https:// link (browsers can't resolve ipfs:// directly). Defaults
# to the team's dedicated gateway in src/utils/ipfsGateway.js if left unset;
# override here to point at a different gateway subdomain.
VITE_PINATA_GATEWAY=

# Goldsky subgraph GraphQL endpoint. When set, dashboard / disputed / role lists
# read from the indexer instead of the contract's looping view functions.
# Leave empty to fall back to on-chain reads. Get this URL from `goldsky subgraph deploy`.
#
# Also read server-side by api/request-invoice-key.js (via api/_lib/subgraph.js)
# to independently source a private escrow's attachment key derivation salt —
# not just by the client. This isn't optional there the way it is for the
# dashboard's on-chain fallback: without it, private escrows with an
# attachment simply can't have their attachment decrypted (the envelope
# itself still unlocks fine). See request-invoice-key.js's file header for
# why this can't be a raw on-chain read instead (Arc Testnet's public RPC
# caps eth_getLogs to a 10,000-block window — well under 2 hours of history).
VITE_GOLDSKY_ENDPOINT=

# Server-side only (read by api/pin-invoice.js, never exposed to the client —
# do NOT prefix with VITE_). Pinata JWT used to pin Create Escrow invoice
# attachments to IPFS. Without it, the invoice uploader's pinning requests
# fail with "Pinning is not configured on the server." Set in the Vercel
# project's environment variables, not just here.
PINATA_JWT=

# Server-side only (read by api/pin-invoice.js and api/request-invoice-key.js
# — do NOT prefix with VITE_). Secret used to deterministically derive the
# AES-256 decryption key for each private-mode invoice (HKDF-SHA256 over this
# secret and the escrow's invoiceHash — no key is ever stored). Without it,
# private-mode invoice pinning fails with "Private invoices are not
# configured on the server." Rotating this secret makes every previously
# pinned private invoice permanently undecryptable — treat it like a
# long-lived signing key, not a rotatable credential. Set in the Vercel
# project's environment variables, not just here.
INVOICE_KEY_SECRET=

# Circle User-Controlled Wallets App ID. Public by design — it identifies the
# app to Circle's browser SDK and is safe to ship to the client, which is why
# this one IS VITE_-prefixed while CIRCLE_API_KEY below is not. Found in the
# Circle Console under Wallets > User Controlled > your app. Without it, the
# "sign in with email" path can't open Circle's OTP or PIN dialogs; connecting
# an existing wallet still works.
VITE_CIRCLE_APP_ID=

# Phase 1 UCW confirmation mode: circle (default) keeps Circle's hosted
# confirmation only; compare adds a Tranche review before it. Any other value,
# including the future native mode, fails closed to circle.
VITE_UCW_CONFIRM_MODE=circle

# Server-side only (read by api/wallet/* — do NOT prefix with VITE_). Circle
# API key for User-Controlled Wallets. This can mint a session token for ANY
# user in the app, so leaking it compromises every email-onboarded wallet —
# treat it like PINATA_JWT's more dangerous sibling. Set in the Vercel
# project's environment variables, not just here.
CIRCLE_API_KEY=

# Upstash Redis credentials backing the email -> Arc address directory that
# lets a payer address an escrow to a freelancer by email, and holding pending
# email verifications (api/_lib/redis.js). Injected automatically when you add
# the Upstash integration to the Vercel project; set them by hand only for
# local `vercel dev`. Without them, email sign-in and the email lookup in
# Create Escrow both fail — wallet-connect escrows are unaffected. This is the
# first durable storage reachable from these serverless functions; everything
# else server-side here is deliberately stateless (see api/_lib/unpinToken.js).
#
# The KV_ prefix is not a typo and does not mean @vercel/kv: the client is
# @upstash/redis (@vercel/kv is deprecated), but Vercel's Upstash integration
# injects the credentials under these names, carried over from the older
# package. Do NOT also set UPSTASH_REDIS_REST_URL / _TOKEN pointing somewhere
# else — see api/_lib/redis.js for why that combination is the one way to
# silently end up talking to the wrong database.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-side only (read by api/_lib/resend.js — do NOT prefix with VITE_).
# Resend credentials for Tranche's OWN email-verification code, sent before a
# freelancer's email is first bound to a payout address. This is deliberately
# a different delivery path from the SMTP configured in Circle Console: it is
# the independent proof of inbox control that Circle's API cannot give us (no
# Circle call maps a userToken back to an email). Without these, first-time
# email sign-ups can still create a wallet and use the app, but cannot be
# looked up by email in Create Escrow — the binding is never written.
# RESEND_FROM must be a verified sender on your Resend domain, e.g.
# "Tranche <noreply@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM=

# Server-side only (read by api/pin-invoice.js and api/unpin-invoice.js — do
# NOT prefix with VITE_). Signs short-lived capability tokens that authorize
# unpinning one specific just-pinned CID (e.g. an abandoned plaintext
# attachment when Create Escrow switches from public to private mode before
# depositing). Without it, pinning still succeeds, but that cleanup silently
# never happens — Tranche just keeps hosting the orphaned file. Deliberately
# a different secret from INVOICE_KEY_SECRET: this one authorizes a
# destructive action on Tranche's storage, INVOICE_KEY_SECRET only derives a
# read-only decryption key, and a leak of one shouldn't compromise the
# other. Set in the Vercel project's environment variables, not just here.
UNPIN_TOKEN_SECRET=
