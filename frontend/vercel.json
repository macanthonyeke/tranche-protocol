{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/pin-invoice.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@|node_modules/|src/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
