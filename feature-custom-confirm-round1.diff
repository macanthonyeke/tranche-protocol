diff --git a/frontend/src/hooks/useTransactionConfirm.js b/frontend/src/hooks/useTransactionConfirm.js
new file mode 100644
index 0000000..8bc8c85
--- /dev/null
+++ b/frontend/src/hooks/useTransactionConfirm.js
@@ -0,0 +1,144 @@
+import { useCallback, useRef, useState, useSyncExternalStore } from 'react'
+import { selectAdapter } from '../confirm/adapters.js'
+
+/* Wallet-agnostic transaction-confirmation flow — Round 1 of the custom
+   confirmation flow. Drives Stage A (this app's own confirm screen, built
+   from a ConfirmDescriptor — see confirm/descriptors.js) and, once the user
+   confirms, hands off to whichever wallet-type adapter matches how they
+   signed in (Circle UCW or EOA/Safe — see confirm/adapters.js). Neither
+   adapter is wired to a real signing call yet; this hook is the seam that
+   Round 2 wires production call sites through, not production wiring
+   itself. */
+
+// ---------------------------------------------------------------------- //
+// Single-flight lock — module-level, deliberately not per-hook-instance.
+//
+// The race this exists to close is useAuth.jsx's executeContractCall
+// (Round 34 finding, see CLAUDE.md's open follow-ups): two DIFFERENT
+// components can each start a transaction against the one shared
+// wallet-signing surface — Circle's SDK singleton for UCW, or a single
+// injected wallet for EOA — before the first one's confirm surface is
+// ready. A lock scoped to one useTransactionConfirm() call site would never
+// see the other component's in-flight call. Module scope is what makes the
+// lock visible across every instance, exactly like the SDK singleton and
+// the injected wallet it is guarding.
+//
+// This closes the race at its actual source — the request/send call this
+// hook's proceed() makes — rather than inside the SDK boundary useAuth.jsx
+// currently has no guard around at all. It also holds regardless of which
+// adapter ends up handling the call, since the lock lives above both.
+// ---------------------------------------------------------------------- //
+
+let locked = false
+const listeners = new Set()
+
+function setLocked(next) {
+  if (locked === next) return
+  locked = next
+  listeners.forEach((listener) => listener())
+}
+
+function subscribeLock(listener) {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+
+function getLockSnapshot() {
+  return locked
+}
+
+/** Test-only escape hatch. Production code never needs this: proceed()'s
+ *  finally block always releases the lock it acquired. Exists because
+ *  vitest reuses this module across test cases within a file, and a test
+ *  that intentionally leaves a call in flight (to assert the lock) would
+ *  otherwise leak that lock into the next test. */
+export function __resetLockForTests() {
+  setLocked(false)
+}
+
+/**
+ * @typedef {'reviewing' | 'confirming' | 'settled' | 'error'} ConfirmStatus
+ */
+
+/**
+ * @param {Object} args
+ * @param {import('../confirm/descriptors.js').ConfirmDescriptor | null} [args.descriptor]
+ *   Stage A's payload. Built by the caller (via confirm/descriptors.js)
+ *   before this hook is ever asked to proceed — building it can require
+ *   on-chain reads (a live CCTP fee quote, escrow state) this hook has no
+ *   business owning.
+ * @param {import('../confirm/adapters.js').TransactionRequest | null} [args.request]
+ *   The calldata-shaped request the confirmed adapter will dispatch.
+ * @param {'circle-sca' | 'eoa' | null} [args.walletType]
+ *   Mirrors useAuth()'s walletType. Passed explicitly rather than read from
+ *   useAuth() directly, so this hook stays testable without mocking React
+ *   context and reusable if a non-Tranche-auth wallet type is ever added.
+ * @param {import('../confirm/adapters.js').TransactionAdapter} [args.adapter]
+ *   Injectable override, for tests. Defaults to selectAdapter(walletType).
+ */
+export function useTransactionConfirm({ descriptor = null, request = null, walletType = null, adapter: injectedAdapter } = {}) {
+  const isLocked = useSyncExternalStore(subscribeLock, getLockSnapshot, getLockSnapshot)
+  const [status, setStatus] = useState(/** @type {ConfirmStatus} */ ('reviewing'))
+  const [hash, setHash] = useState(null)
+  const [error, setError] = useState(null)
+  // Whichever call actually acquired the lock owns releasing it — guards
+  // against a second, rejected call's finally block releasing a lock the
+  // FIRST call still legitimately holds.
+  const ownsLockRef = useRef(false)
+
+  const proceed = useCallback(async () => {
+    if (locked) {
+      const err = new Error('Another transaction is already awaiting confirmation. Wait for it to finish.')
+      setStatus('error')
+      setError(err)
+      throw err
+    }
+    if (!descriptor || !request) {
+      const err = new Error('Nothing to confirm yet.')
+      setStatus('error')
+      setError(err)
+      throw err
+    }
+    const adapter = injectedAdapter ?? selectAdapter(walletType)
+    if (!adapter) {
+      const err = new Error('No wallet is connected.')
+      setStatus('error')
+      setError(err)
+      throw err
+    }
+
+    // Acquired synchronously, before the first await below — this is what
+    // makes the guard correct against genuinely concurrent calls, not just
+    // sequential ones: JS run-to-completion means a second proceed() call
+    // fired before this one yields control will see `locked === true` at
+    // its own top-of-function check above, deterministically, every time.
+    setLocked(true)
+    ownsLockRef.current = true
+    setStatus('confirming')
+    setError(null)
+    try {
+      const result = await adapter.send(request, descriptor)
+      const txHash = await adapter.awaitHash(result)
+      setHash(txHash)
+      setStatus('settled')
+      return txHash
+    } catch (err) {
+      setStatus('error')
+      setError(err)
+      throw err
+    } finally {
+      if (ownsLockRef.current) {
+        setLocked(false)
+        ownsLockRef.current = false
+      }
+    }
+  }, [descriptor, request, walletType, injectedAdapter])
+
+  const reset = useCallback(() => {
+    setStatus('reviewing')
+    setHash(null)
+    setError(null)
+  }, [])
+
+  return { status, descriptor, hash, error, locked: isLocked, proceed, reset }
+}
diff --git a/frontend/src/hooks/useTransactionConfirm.test.jsx b/frontend/src/hooks/useTransactionConfirm.test.jsx
new file mode 100644
index 0000000..94767c9
--- /dev/null
+++ b/frontend/src/hooks/useTransactionConfirm.test.jsx
@@ -0,0 +1,160 @@
+import { describe, it, expect, vi, afterEach } from 'vitest'
+import { renderHook, act } from '@testing-library/react'
+
+import { useTransactionConfirm, __resetLockForTests } from './useTransactionConfirm.js'
+
+afterEach(() => __resetLockForTests())
+
+const DESCRIPTOR = { kind: 'same-chain', title: 't', subtitle: 's', functionName: 'claimDelivery', parameters: [] }
+const REQUEST = { address: '0xabc', abi: [], functionName: 'claimDelivery', args: [1n, 0n] }
+
+/** A promise the test can resolve/reject on its own schedule, so a hook's
+ *  proceed() can be held "in flight" for exactly as long as a concurrency
+ *  assertion needs — not a real async gap, but a genuinely uncontrolled one
+ *  from the hook's perspective, which is what a race needs to be meaningful. */
+function deferred() {
+  let resolve, reject
+  const promise = new Promise((res, rej) => { resolve = res; reject = rej })
+  return { promise, resolve, reject }
+}
+
+function fakeAdapter({ sendResult = { hash: '0xHASH' }, hash = '0xHASH', sendImpl, hashImpl } = {}) {
+  return {
+    type: 'circle-sca',
+    send: sendImpl ?? vi.fn().mockResolvedValue(sendResult),
+    awaitHash: hashImpl ?? vi.fn().mockResolvedValue(hash)
+  }
+}
+
+describe('useTransactionConfirm — state machine', () => {
+  it('starts reviewing and moves to settled on a successful adapter round trip', async () => {
+    const adapter = fakeAdapter({ hash: '0xDEADBEEF' })
+    const { result } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter }))
+
+    expect(result.current.status).toBe('reviewing')
+    expect(result.current.locked).toBe(false)
+
+    let returned
+    await act(async () => { returned = await result.current.proceed() })
+
+    expect(returned).toBe('0xDEADBEEF')
+    expect(result.current.status).toBe('settled')
+    expect(result.current.hash).toBe('0xDEADBEEF')
+    expect(result.current.locked).toBe(false)
+    expect(adapter.send).toHaveBeenCalledWith(REQUEST, DESCRIPTOR)
+  })
+
+  it('moves to error when the adapter rejects, and releases the lock', async () => {
+    const adapter = fakeAdapter({ sendImpl: vi.fn().mockRejectedValue(new Error('user declined')) })
+    const { result } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter }))
+
+    await act(async () => {
+      await expect(result.current.proceed()).rejects.toThrow('user declined')
+    })
+
+    expect(result.current.status).toBe('error')
+    expect(result.current.error.message).toBe('user declined')
+    expect(result.current.locked).toBe(false)
+  })
+
+  it('rejects immediately, with no adapter call, when descriptor or request is missing', async () => {
+    const adapter = fakeAdapter()
+    const { result } = renderHook(() => useTransactionConfirm({ descriptor: null, request: REQUEST, adapter }))
+
+    await act(async () => {
+      await expect(result.current.proceed()).rejects.toThrow('Nothing to confirm yet.')
+    })
+    expect(adapter.send).not.toHaveBeenCalled()
+    expect(result.current.status).toBe('error')
+  })
+
+  it('reset() returns to reviewing and clears hash/error', async () => {
+    const adapter = fakeAdapter({ hash: '0xAAA' })
+    const { result } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter }))
+    await act(async () => { await result.current.proceed() })
