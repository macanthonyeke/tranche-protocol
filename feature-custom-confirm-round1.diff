+
+describe('useTransactionConfirm — single-flight guard, genuinely concurrent calls', () => {
+  it('a second proceed() on the SAME instance rejects while the first is still in flight, then a later call succeeds', async () => {
+    const gate = deferred()
+    const adapter = fakeAdapter({ sendImpl: vi.fn().mockReturnValue(gate.promise), hash: '0xFIRST' })
+    const { result } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter }))
+
+    let firstPromise, secondPromise
+    await act(async () => {
+      // Both calls fired without awaiting the first — this is what makes it
+      // a genuine race rather than two sequential calls. JS run-to-completion
+      // means the first call runs synchronously up to its `await
+      // adapter.send(...)`, acquiring the lock, before this line's second
+      // call ever starts executing.
+      firstPromise = result.current.proceed()
+      secondPromise = result.current.proceed()
+      await expect(secondPromise).rejects.toThrow('Another transaction is already awaiting confirmation.')
+    })
+
+    // The lock is still held — the first call hasn't resolved yet.
+    expect(result.current.locked).toBe(true)
+
+    await act(async () => { gate.resolve({ hash: '0xFIRST' }) })
+    await act(async () => { await firstPromise })
+
+    expect(result.current.status).toBe('settled')
+    expect(result.current.hash).toBe('0xFIRST')
+    expect(result.current.locked).toBe(false)
+    expect(adapter.send).toHaveBeenCalledTimes(1)
+
+    // The lock being released means a subsequent call is not permanently
+    // blocked by the earlier rejection — confirms the guard is a queue-of-one,
+    // not a one-way trip to a stuck state.
+    const adapter2 = fakeAdapter({ hash: '0xSECOND' })
+    const { result: result2 } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter: adapter2 }))
+    await act(async () => { await result2.current.proceed() })
+    expect(result2.current.status).toBe('settled')
+  })
+
+  it('the lock is visible ACROSS two different component instances — the actual shape of the useAuth.jsx race', async () => {
+    // Round 34's finding was two DIFFERENT components racing the same
+    // shared SDK singleton, not one component double-firing its own button.
+    // The lock has to be module-level for this test to mean anything — a
+    // per-instance lock would let both of these through.
+    const gateA = deferred()
+    const adapterA = fakeAdapter({ sendImpl: vi.fn().mockReturnValue(gateA.promise) })
+    const adapterB = fakeAdapter({ hash: '0xB' })
+
+    const { result: componentA } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter: adapterA }))
+    const { result: componentB } = renderHook(() => useTransactionConfirm({ descriptor: DESCRIPTOR, request: REQUEST, adapter: adapterB }))
+
+    let promiseA
+    await act(async () => {
+      promiseA = componentA.current.proceed()
+    })
+    // componentA's own render hasn't necessarily flushed synchronously from
+    // inside its own act() in every RTL version, but the module-level store
+    // update is synchronous — componentB, a wholly separate hook instance,
+    // must already observe the lock.
+    expect(componentB.current.locked).toBe(true)
+
+    await act(async () => {
+      await expect(componentB.current.proceed()).rejects.toThrow('Another transaction is already awaiting confirmation.')
+    })
+    expect(adapterB.send).not.toHaveBeenCalled()
+
+    await act(async () => { gateA.resolve({ hash: '0xA' }) })
+    await act(async () => { await promiseA })
+
+    expect(componentA.current.status).toBe('settled')
+    expect(componentB.current.locked).toBe(false)
+
+    // Now that A released it, B can actually go.
+    await act(async () => { await componentB.current.proceed() })
+    expect(componentB.current.status).toBe('settled')
