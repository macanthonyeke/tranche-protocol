+    const old = redirectPayoutConfirm(args)
+    const next = buildRedirectPayoutDescriptor({ ...args, contractAddress: CONTRACT_ADDRESS })
+    expect(commonFields(next)).toEqual(commonFields(old))
+    expect(next.kind).toBe('cross-chain')
